# Copy to .env. docker compose and Bun both load it.
# Models and upload limits live in config.yaml. Secrets live here.

OPENAI_API_KEY=
CLERK_SECRET_KEY=

# Host URLs for bun run dev. docker compose overrides these inside the api container.
MONGODB_URI=mongodb://fireflies:fireflies@localhost:27017/fireflies?authSource=admin&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fireflies
S3_REGION=us-east-1

# Optional. Use this when the public blob URL must differ from S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# Optional. Next.js runs on 8080. CORS defaults to * when unset.
FRONTEND_ORIGIN=http://localhost:8080

PORT=3000
