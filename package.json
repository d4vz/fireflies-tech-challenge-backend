{
  "name": "hono",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1123.0",
    "@aws-sdk/lib-storage": "3.1123.0",
    "@hono/node-server": "^1.19.9",
    "@smithy/node-http-handler": "^4.12.0",
    "bullmq": "^6.3.3",
    "hono": "^4.13.5",
    "ioredis": "^6.0.0",
    "mongodb": "6.17.0",
    "openai": "^7.8.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "1.4.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  }
}
